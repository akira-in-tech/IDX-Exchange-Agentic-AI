# Optional fallback retained for compatibility with the original Week 6 code.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=256

# Default Week 6 provider. Put the real key only in the ignored `.env` file.
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
# Generated vectors contain MLS-derived data, so the index lives outside Git.
IDX_SEMANTIC_INDEX=~/.openclaw/state/idx-semantic-index.jsonl

# Read-only local MLS connection shared by Weeks 3 through 6.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=idx_exchange
MYSQL_CONNECTION_LIMIT=5

# Reserved for future notification integrations; unused by current skills.
EMAIL_USER=
EMAIL_PASSWORD=
